<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ficha Arcana - Edição Digital</title>
</head>
<style>
    .campo-wrapper {
  position: relative;
  display: inline-block;
}
.campo-wrapper input {
  width: 350px;
  height: 40px;
  font-size: 16px;
  padding: 8px;
}
/* Label no canto superior direito */
.label-top-right {
  position: absolute;
  top: -10px;
  right: 5px;
  font-size: 12px;
  background: transparent;
}
/* Label embaixo à esquerda */
.label-bottom-left {
  position: absolute;
  bottom: -12px;
  left: 0;
  font-size: 12px;
  background: transparent;
}
</style>
<div class="campo-wrapper">
  <label class="label-top-right">JOGADOR</label>
  <input type="text">
  <label class="label-bottom-left">PERSONAGEM</label>
</div>
